# Одноразовое живёт в ~/codextmp, а не здесь.
*.log
*.tmp
*.bak
*.orig
*.rej
*~
.DS_Store
__pycache__/
*.pyc

# SQLite собирается из сливаемой схемы и текстовых дампов.
db/story.db
db/export/

# Unaccepted TTS originals and receipts belong to the voice backup, not GitHub.
voice/draft/

# Accepted office originals/receipts are backed up as voice; only their provenance manifest is in Git.
voice/accepted/office-intro/*
!voice/accepted/office-intro/manifest.json

# The additions retain their own revisions and hearing receipt; no WAV/API receipts in Git.
voice/accepted/office-intro-additions-20261002/*
!voice/accepted/office-intro-additions-20261002/manifest.json
